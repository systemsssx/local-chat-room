# ════════════════════════════════════════════════════════════
#  注意：.gitignore **不支持行尾注释** —— `data/   # 说明` 会被当成
#  一个完整模式（里面带 # 和空格），结果那个目录**根本没被忽略**。
#  这条踩过：原来两行都带行尾注释，data/ 与 uploads/ 照常提交进仓库了。
#  注释一律单独占一行。
# ════════════════════════════════════════════════════════════

# ── 运行时数据（不进 Git；交付包里会带一份，见 release 附件）──
# SQLite 数据库（含 -wal / -shm / legacy-*.bak）
data/
# 上传的图片与文件（二进制放磁盘，库里只存 URL）
uploads/

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 环境与密钥 ────────────────────────────────────────
.env
*.key

# ── 杂项 ──────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
