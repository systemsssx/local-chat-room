# ════════════════════════════════════════════════════════════
#  注意：.gitignore **不支持行尾注释** —— `data/   # 说明` 会被当成
#  一个完整模式（里面带 # 和空格），结果那个目录**根本没被忽略**。
#  这条踩过：原来三行都带行尾注释，`data/`、`uploads/`、`dev/tmp/`
#  全都照常提交进仓库了。注释一律单独占一行。
# ════════════════════════════════════════════════════════════

# ── 运行时数据（不该进 Git；交付包里会带一份，见 release 附件）──
# SQLite 数据库（含 -wal / -shm）
data/
# 上传的图片与文件（二进制放磁盘，不入库）
uploads/
# 造出来的示例文件
dev/tmp/

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node（alt-node/ 是 Node 版对照实现）───────────────
node_modules/
alt-node/node_modules/
npm-debug.log*

# ── 环境与密钥（题目明确要求不要提交）────────────────
.env
*.key

# ── 杂项 ──────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
